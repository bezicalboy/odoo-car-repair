<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_car_repair_order" model="ir.sequence">
            <field name="name">Car Repair Order</field>
            <field name="code">car.repair.order</field>
            <field name="prefix">SR</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_car_diagnosis" model="ir.sequence">
            <field name="name">Car Diagnosis</field>
            <field name="code">car.diagnosis</field>
            <field name="prefix">DIAG</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_car_repair_workorder" model="ir.sequence">
            <field name="name">Car Work Order</field>
            <field name="code">car.repair.workorder</field>
            <field name="prefix">WO</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
