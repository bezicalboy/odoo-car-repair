<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="checklist_engine_oil" model="car.repair.checklist">
            <field name="name">Oil replacement</field>
            <field name="description">Drain and refill the engine oil, replace the oil filter</field>
            <field name="sequence">10</field>
        </record>

        <record id="checklist_brake" model="car.repair.checklist">
            <field name="name">Brake repair</field>
            <field name="description">Check pads, discs and brake fluid level</field>
            <field name="sequence">20</field>
        </record>

        <record id="checklist_battery" model="car.repair.checklist">
            <field name="name">Battery replacement</field>
            <field name="description">Test the battery load and replace it if needed</field>
            <field name="sequence">30</field>
        </record>

        <record id="checklist_wheel_alignment" model="car.repair.checklist">
            <field name="name">Wheel alignment</field>
            <field name="description">Align the wheels and check the tyre pressure</field>
            <field name="sequence">40</field>
        </record>

        <record id="checklist_car_paint" model="car.repair.checklist">
            <field name="name">Car paint</field>
            <field name="description">Inspect the bodywork and the paint condition</field>
            <field name="sequence">50</field>
        </record>

        <record id="product_car_repair_labour" model="product.template">
            <field name="name">Car Repair Labour (Hour)</field>
            <field name="type">service</field>
            <field name="invoice_policy">delivery</field>
            <field name="list_price">50.0</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
        </record>

    </data>
</odoo>
