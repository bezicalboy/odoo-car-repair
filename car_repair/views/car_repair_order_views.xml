<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_car_repair_order_list" model="ir.ui.view">
        <field name="name">car.repair.order.list</field>
        <field name="model">car.repair.order</field>
        <field name="arch" type="xml">
            <list string="Car Repair Orders" sample="1">
                <field name="name"/>
                <field name="subject"/>
                <field name="partner_id"/>
                <field name="contact_number" optional="show"/>
                <field name="date_receipt"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('received', 'in_diagnosis')"
                       decoration-success="state == 'done'"
                       decoration-muted="state == 'cancel'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_car_repair_order_form" model="ir.ui.view">
        <field name="name">car.repair.order.form</field>
        <field name="model">car.repair.order</field>
        <field name="arch" type="xml">
            <form string="Car Repair Order">
                <header>
                    <button name="action_create_diagnosis" type="object" string="Create Car Diagnosis"
                            class="btn-primary" invisible="state not in ('received', 'in_diagnosis')"
                            groups="car_repair.group_service_manager"/>
                    <button name="%(action_report_car_receipt)d" type="action" string="Print Receipt"/>
                    <button name="%(action_report_car_label)d" type="action" string="Print Label"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="received,in_diagnosis,quotation_sent,quotation_approved,work_in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_diagnosis" type="object" class="oe_stat_button"
                                icon="fa-stethoscope" invisible="diagnosis_count == 0">
                            <field name="diagnosis_count" widget="statinfo" string="Diagnoses"/>
                        </button>
                        <button name="action_view_sale_order" type="object" class="oe_stat_button"
                                icon="fa-dollar" invisible="sale_order_count == 0">
                            <field name="sale_order_count" widget="statinfo" string="Quotations"/>
                        </button>
                        <button name="action_view_workorder" type="object" class="oe_stat_button"
                                icon="fa-wrench" invisible="workorder_count == 0">
                            <field name="workorder_count" widget="statinfo" string="Work Orders"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="subject" placeholder="e.g. Battery replacement"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="priority" widget="priority"/>
                            <field name="date_receipt"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="General" name="general">
                            <group>
                                <group string="Client Info">
                                    <field name="partner_id"/>
                                    <field name="contact_name"/>
                                    <field name="phone"/>
                                    <field name="mobile"/>
                                    <field name="email" widget="email"/>
                                    <field name="contact_number"/>
                                </group>
                            </group>
                            <separator string="Car &amp; Service Details"/>
                            <field name="car_line_ids">
                                <list string="Car Details" editable="bottom">
                                    <field name="vehicle_id"/>
                                    <field name="license_plate"/>
                                    <field name="model_id"/>
                                    <field name="vin_sn"/>
                                    <field name="fuel_type"/>
                                    <field name="odometer" optional="show"/>
                                    <field name="under_guarantee" widget="boolean_toggle"/>
                                    <field name="guarantee_type"/>
                                    <field name="nature_of_service"/>
                                    <field name="state" widget="badge" readonly="1"/>
                                </list>
                                <form string="Car Details">
                                    <group>
                                        <group>
                                            <field name="vehicle_id"/>
                                            <field name="license_plate"/>
                                            <field name="vin_sn"/>
                                        </group>
                                        <group>
                                            <field name="model_id"/>
                                            <field name="fuel_type"/>
                                            <field name="odometer"/>
                                        </group>
                                    </group>
                                    <notebook>
                                        <page string="Service Details" name="service_details">
                                            <group>
                                                <group>
                                                    <field name="under_guarantee" widget="radio"/>
                                                    <field name="guarantee_type" widget="radio"
                                                           invisible="not under_guarantee"/>
                                                </group>
                                                <group>
                                                    <field name="nature_of_service"/>
                                                    <field name="state"/>
                                                </group>
                                            </group>
                                            <separator string="Service Details"/>
                                            <field name="service_details" nolabel="1"
                                                   placeholder="Details of the service to perform on this car..."/>
                                        </page>
                                    </notebook>
                                </form>
                            </field>
                        </page>
                        <page string="Service Repair Checklist" name="checklist">
                            <field name="checklist_line_ids">
                                <list string="Repair Checklist" editable="bottom">
                                    <field name="checklist_id"/>
                                    <field name="note"/>
                                    <field name="is_done" widget="boolean_toggle"/>
                                    <field name="create_uid" string="Created by" optional="show"/>
                                </list>
                            </field>
                            <button name="%(action_report_car_checklist)d" type="action"
                                    string="Print Checklist" class="btn-secondary mt-2"
                                    invisible="not checklist_line_ids"/>
                        </page>
                        <page string="Repair Note" name="note">
                            <field name="note" placeholder="Notes about the repair..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_car_repair_order_search" model="ir.ui.view">
        <field name="name">car.repair.order.search</field>
        <field name="model">car.repair.order</field>
        <field name="arch" type="xml">
            <search string="Car Repair Orders">
                <field name="name"/>
                <field name="subject"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <filter name="filter_my" string="My Repair Orders"
                        domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="filter_open" string="Open"
                        domain="[('state', 'not in', ('done', 'cancel'))]"/>
                <filter name="filter_done" string="Done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="filter_date_receipt" string="Date of Receipt"
                        date="date_receipt"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_partner" string="Client" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_user" string="Assigned to" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_car_repair_order" model="ir.actions.act_window">
        <field name="name">Car Repair</field>
        <field name="res_model">car.repair.order</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a car repair order</p>
            <p>Register the client, the cars and the inspection checklist of a repair.</p>
        </field>
    </record>

</odoo>
