<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_car_repair" model="ir.ui.view">
        <field name="name">sale.order.form.car.repair</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_car_repair_order" type="object" class="oe_stat_button"
                        icon="fa-truck" invisible="not car_repair_order_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Repair Order</span>
                    </div>
                </button>
                <button name="action_view_car_workorder" type="object" class="oe_stat_button"
                        icon="fa-wrench" invisible="car_workorder_count == 0">
                    <field name="car_workorder_count" widget="statinfo" string="Work Orders"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="before">
                <field name="car_line_id" optional="show"
                       domain="[('repair_order_id', '=', parent.car_repair_order_id)]"/>
                <field name="car_model_id" string="Model #" optional="show"/>
                <field name="car_license_plate" string="License Plate" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="car_repair_order_id" invisible="not car_repair_order_id" readonly="1"/>
                <field name="car_diagnosis_id" invisible="not car_diagnosis_id" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_car_repair" model="ir.ui.view">
        <field name="name">account.move.form.car.repair</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="before">
                <field name="car_model_id" string="Model #" optional="show"/>
                <field name="car_license_plate" string="License Plate" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
