<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_car_repair_checklist_list" model="ir.ui.view">
        <field name="name">car.repair.checklist.list</field>
        <field name="model">car.repair.checklist</field>
        <field name="arch" type="xml">
            <list string="Checklists" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
                <field name="create_uid" string="Created by" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_car_repair_checklist_form" model="ir.ui.view">
        <field name="name">car.repair.checklist.form</field>
        <field name="model">car.repair.checklist</field>
        <field name="arch" type="xml">
            <form string="Checklist">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Oil replacement"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_car_repair_checklist_search" model="ir.ui.view">
        <field name="name">car.repair.checklist.search</field>
        <field name="model">car.repair.checklist</field>
        <field name="arch" type="xml">
            <search string="Checklists">
                <field name="name"/>
                <filter name="filter_inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_create_uid" string="Created by" context="{'group_by': 'create_uid'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_car_repair_checklist" model="ir.actions.act_window">
        <field name="name">Checklists</field>
        <field name="res_model">car.repair.checklist</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a checklist item</p>
            <p>Checklist items are the inspection points that can be added to a car repair order.</p>
        </field>
    </record>

</odoo>
