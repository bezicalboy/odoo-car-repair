<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Car Invoice Report: the native invoice with the car columns added,
         so the workshop invoice states which car was serviced. -->
    <template id="report_invoice_document_car_repair" inherit_id="account.report_invoice_document">
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_car_model" class="text-start"><span>Model #</span></th>
            <th name="th_car_plate" class="text-start"><span>License Plate</span></th>
        </xpath>
        <xpath expr="//td[@name='account_invoice_line_name']" position="before">
            <td name="td_car_model">
                <span t-field="line.car_model_id">A1</span>
            </td>
            <td name="td_car_plate">
                <span t-field="line.car_license_plate">1-AUD-001</span>
            </td>
        </xpath>
    </template>

</odoo>
